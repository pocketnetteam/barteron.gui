{
  "name": "barteron-nextgen",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/vue-query": "^5.107.1",
    "hls.js": "1.5.20",
    "leaflet": "1.9.4",
    "ngeohash": "^0.6.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/leaflet": "1.9.12",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^16.4.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.4.2",
    "vitest": "^3.2.4",
    "vue-tsc": "3.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
