{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "build/**/*.ts",
    "e2e/**/*.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM"]
  }
}
